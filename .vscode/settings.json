{

  /* Vertical guidelines for line wrapping. */
  "editor.rulers": [
    80,
    100,
    120,
    140,
    160,
  ],

  /* By default, wrap long lines at the viewport or 120 characters,
  whichever is narrowest. */
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 120,

  /* This repo is an Antora content source (src/antora.yml), not a
  standalone document set. Prompt to enable Antora support so the AsciiDoc
  extension resolves `partial$`/`example$`/`xref:` resource IDs against the
  component root, instead of reporting "include path not found" for valid
  partials under src/modules/ROOT/partials/. */
  "asciidoc.antora.showEnableAntoraPrompt": true,

  "[asciidoc]": {
    /* Wrap documentation files at the viewport width. Hard-wrapping
    should be applied at 80 characters, except for tables and long URLs. */
    "editor.wordWrap": "on",

    /* Enable auto-formatting for Asciidoc files. */
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,

    /* Enable auto-fixes for Asciidoc files. */
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
    },
  },

  "[markdown]": {
    /* Wrap documentation files at the viewport width. Hard-wrapping
    should be applied at 80 characters, except for tables and long URLs. */
    "editor.wordWrap": "on",

    /* Enable auto-formatting for Markdown files. */
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,

    /* Enable auto-fixes for Markdown files. */
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
    },
  },

  "[skill]": {
    /* Matches Markdown settings. */
    "editor.wordWrap": "on",

    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,

    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
    },
  },

}
